{
  "version": 2,
  "functions": {
    "server/src/index.js": {
      "runtime": "vercel-node@latest",
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/src/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
